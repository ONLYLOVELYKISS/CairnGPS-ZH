    <!-- Onboarding tour -->
    <string name="onboarding_step_1_title">欢迎使用 CairnGPS</string>
    <string name="onboarding_step_1_body">本快速引导使用示例数据，其中的位置和历史记录都不是真实数据。点击任意位置继续。</string>
    <string name="onboarding_step_2_title">查看您的坐标</string>
    <string name="onboarding_step_2_body">纬度和经度会实时更新。点击卡片即可复制坐标，也可以在设置中切换十进制度和度分秒格式。</string>
    <string name="onboarding_step_3_title">海拔与信号质量</string>
    <string name="onboarding_step_3_body">海拔以米为单位显示。彩色圆点表示 GPS 精度：绿色表示良好，橙色表示一般，红色表示较差。破折号表示尚未定位。</string>
    <string name="onboarding_step_4_title">标记地点，记录徒步</string>
    <string name="onboarding_step_4_body">保存当前位置为航点，或开始记录轨迹，记录沿途的距离、海拔和速度。</string>
    <string name="onboarding_step_5_title">试试罗盘</string>
    <string name="onboarding_step_5_body">点击“导航”查看您的方向以及到目标的方位。</string>
    <string name="onboarding_step_6_title">找到前进方向</string>
    <string name="onboarding_step_6_body">罗盘显示您的航向，可以选择真北或磁北。选择已保存的航点作为目标，即可查看方位和距离。</string>
    <string name="onboarding_step_7_title">查看头顶的卫星</string>
    <string name="onboarding_step_7_body">查看 GPS 芯片当前能接收到的卫星信号。</string>
    <string name="onboarding_step_8_title">天空图</string>
    <string name="onboarding_step_8_body">每个点代表一颗卫星，其位置根据方位角和仰角绘制。颜色表示所属星座，实心点表示该卫星已参与定位。</string>
    <string name="onboarding_step_9_title">查看 3D 视图</string>
    <string name="onboarding_step_9_body">打开 3D 地球仪，更全面地了解您头顶的卫星。</string>
    <string name="onboarding_step_10_title">3D 地球仪</string>
    <string name="onboarding_step_10_body">拖动以旋转地球仪，点击卫星查看其详细信息。</string>
    <string name="onboarding_step_11_title">个人资料</string>
    <string name="onboarding_step_11_body">前往个人资料，查看您的进度和历史记录。</string>
    <string name="onboarding_step_12_title">您的记录</string>
    <string name="onboarding_step_12_body">记录页面会保存您标记的所有航点和录制的所有徒步轨迹。</string>
    <string name="onboarding_step_13_title">航点和轨迹</string>
    <string name="onboarding_step_13_body">在已保存的航点和已录制的轨迹之间切换。点击任一条目可查看详情。</string>
    <string name="onboarding_step_14_title">成就</string>
    <string name="onboarding_step_14_body">徒步可以解锁成就和等级。点击此处查看完整目录。</string>
    <string name="onboarding_step_15_title">追踪进度</string>
    <string name="onboarding_step_15_body">每枚徽章都代表一个里程碑，从标记第一个航点到登上最高的山峰。</string>
    <string name="onboarding_step_16_title">准备就绪</string>
    <string name="onboarding_step_16_body">引导到此结束。您可以随时在设置中重新查看。</string>
    <string name="onboarding_skip">跳过</string>
    <string name="onboarding_next">下一步</string>
